# ====== Kopejiet so failu uz ".env" un aizpildiet ======
# cp .env.example .env
# (.env NEKAD nenonak github / nedalies ar to ne ar vienu)

# Mainnet RPC (bezmaksas: Alchemy vai Infura konts -> https URL)
RPC_URL=https://eth-mainnet.g.alchemy.com/v2/TAVS_ATSLEGAS_ID
CHAIN_ID=1

# Privatas atslegas (BEZ "0x" priedekla nav obligati; ethers pieņem abus)
COMPROMISED_PK=uzlauta_maka_privata_atslega
SPONSOR_PK=tira_maka_privata_atslega_kas_maksa_gazi

# Kurp suti izglabtos lidzeklus (jauns, dross maks)
SAFE_ADDRESS=0xTavsDrosaisMaks

# ---- Solis 1: withdraw/unstake (GWEI VotingEscrow / veGWEI) ----
# PARBAUDITS on-chain: veGWEI kontrakts, token()=GWEI, withdraw() selektors atrasts kodaa.
# withdraw() izņem VISU lock'oto GWEI atpakal uz makou (pec lock beigam - tavs ir beidzies).
STAKING_CONTRACT=0x13ab49189ebc2287e941a82d9af154130f96eb21
WITHDRAW_DATA=0x3ccfd60b
WITHDRAW_VALUE=0

# ---- Solis 2: ko parsutit uz droso maku ----
# ETHGas $GWEI tokens (PARBAUDITS on-chain: symbol=GWEI, decimals=18)
ASSET_TYPE=ERC20
TOKEN_ADDRESS=0x2798b1cc5a993085e8a9d46e80499f1b63f42204
TOKEN_DECIMALS=18
# Cik GWEI parsutit. PRECIZS lock'otais daudzums (nolasits on-chain).
# Pec withdraw() maka bus tiesi sis daudzums (brivais atlikums bija 0).
AMOUNT=630.342350174325

# ---- Gaze / megnajumi ----
PRIORITY_GWEI=3
GAS_LIMIT_WITHDRAW=320000
GAS_LIMIT_TRANSFER=90000
BLOCKS_TO_TRY=25
